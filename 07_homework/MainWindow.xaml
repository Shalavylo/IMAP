<Window x:Class="_07_homework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_07_homework"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Email:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtUsername" Width="180" Margin="2,0,10,0" VerticalAlignment="Center"/>

            <Label Content="Пароль (App):" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPassword" Width="160" Margin="2,0,10,0" VerticalAlignment="Center"/>

            <Button Content="Підключитися (IMAP)" Click="Click_ConnectImap" Width="140" Height="25" Margin="0,0,10,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="lstFolders" Grid.Column="0" Margin="0,0,5,0" SelectionChanged="LstFolders_SelectionChanged"/>

            <ListBox x:Name="lstMessages" Grid.Column="1" Margin="5,0,5,0" SelectionChanged="LstMessages_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Subject}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Date}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TabControl Grid.Column="2" Margin="5,0,0,0">
                <TabItem Header="Перегляд листа">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="lblMailFrom" Grid.Row="0" Margin="2"/>
                        <TextBlock x:Name="lblMailDate" Grid.Row="1" Margin="2"/>
                        <TextBlock x:Name="lblMailSubject" Grid.Row="2" FontWeight="Bold" Margin="2"/>
                        <TextBox x:Name="txtMailBody" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Margin="2"/>
                        <ListBox x:Name="lstAttachments" Grid.Row="4" Height="60" Margin="2"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Написати листа">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Отримувач:" Grid.Row="0" Grid.Column="0"/>
                        <TextBox x:Name="txtRecipient" Grid.Row="0" Grid.Column="1" Margin="2"/>

                        <Label Content="Тема:" Grid.Row="1" Grid.Column="0"/>
                        <TextBox x:Name="txtSubject" Grid.Row="1" Grid.Column="1" Margin="2"/>

                        <CheckBox x:Name="chkHighPriority" Content="Високий пріоритет" Grid.Row="2" Grid.Column="1" Margin="2"/>

                        <TextBox x:Name="txtBody" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" AcceptsReturn="True" TextWrapping="Wrap" Margin="2"/>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5">
                            <Button Content="Прикріпити файл" Click="Click_AttachFile" Width="130" Margin="0,0,10,0"/>
                            <TextBlock x:Name="lblAttachedFileName" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <Button Content="Надіслати" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="30" Click="Click_MessageSend" Margin="0,5,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
